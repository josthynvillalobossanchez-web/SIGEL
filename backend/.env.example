# Copie este archivo como .env y complete los valores.
# backend/.env NUNCA se sube al repositorio.

# --- Base de datos ---
# Usuario, contrasena y nombre de la base son los mismos del .env de la raiz,
# el que usa docker-compose para levantar MySQL.
# El puerto es 3307 porque asi se publico el contenedor.
#
# IMPORTANTE: use 127.0.0.1, no "localhost". En Windows "localhost" se resuelve
# primero como IPv6 (::1) y Docker publica el puerto solo en IPv4, asi que la
# conexion se cuelga diez segundos y termina en "connect ECONNREFUSED ::1:3307".
DATABASE_URL="mysql://sigel:CONTRASENA_DEL_ENV_RAIZ@127.0.0.1:3307/sigel"

# Conexion cifrada con la base de datos.
# En desarrollo va en false: la conexion no sale de esta maquina.
# En el servidor de la Municipalidad va en true (Joseph, 30/09).
BD_TLS=false
# Si el certificado de MySQL lo firma una autoridad propia (el ca.pem que se
# genera siguiendo la GUIA, seccion "Despliegue"), ruta a ese ca.pem.
# Vacio = se exige un certificado de una autoridad reconocida.
# OJO: el certificado que MySQL genera solo al arrancar NO sirve (no trae el
# nombre 127.0.0.1/localhost y la verificacion lo rechaza, como debe).
BD_TLS_CA=

# --- Servidor ---
PUERTO=3000
# Origen del frontend. En desarrollo, Vite. En el servidor, la direccion real
# con https (el subdominio de munipalmares donde quede SIGEL).
ORIGEN_FRONTEND=http://localhost:5173

# HTTPS directo (el servidor no tiene proxy inverso, Joseph 30/09): rutas al
# certificado y a su llave en formato .pem. Vacios = HTTP (solo desarrollo).
CERTIFICADO_HTTPS=
LLAVE_HTTPS=

# Interfaz compilada (cd frontend && npm run build). Si se indica, este mismo
# proceso sirve la interfaz y /api en el mismo dominio. Vacio en desarrollo.
# Ejemplo en el servidor: RUTA_FRONTEND=../frontend/dist
RUTA_FRONTEND=

# Registros (logs) de la aplicacion: un archivo por dia, sigel-AAAA-MM-DD.log.
# Por defecto la carpeta "registros" dentro de backend. TI decide que hacer con
# ella (respaldo, limpieza). No se sube a git.
RUTA_REGISTROS=./registros

# --- Seguridad ---
# Cadena larga y aleatoria. Genere una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=
JWT_EXPIRACION=8h

# La sesion viaja en una cookie httpOnly. La marca "Secure" exige HTTPS, asi que
# en desarrollo (localhost) va en false y en el servidor va en true (SIGEL se
# sirve por HTTPS, confirmado por Joseph el 30/09).
COOKIE_SEGURA=false

# --- Correo saliente ---
# "consola" imprime los mensajes en la terminal, sin enviar nada (desarrollo).
# "smtp" envia de verdad. La Municipalidad usa una cuenta de Gmail para esto
# (Joseph, 30/09). Pasos en docs/GUIA_DESARROLLO.md, seccion 10.
CORREO_TRANSPORTE=consola
# Solo con smtp. Gmail: servidor smtp.gmail.com, puerto 465.
CORREO_SERVIDOR=smtp.gmail.com
CORREO_PUERTO=465
# La cuenta de Gmail completa (ejemplo: cuenta@gmail.com).
CORREO_USUARIO=
# La CONTRASENA DE APLICACION de Gmail (16 letras), NO la contrasena normal
# de la cuenta. Nunca se sube a git ni se escribe en otro lado.
CORREO_CONTRASENA=
# Nombre que ve quien recibe el correo.
CORREO_NOMBRE_REMITENTE=SINERGIA - Municipalidad de Palmares

# --- Archivos del expediente ---
# Carpeta "archivos" dentro de backend, en desarrollo y en el servidor
# (decision de Josthyn, 30/09). TI se encarga de incluirla en el respaldo.
# No se sube a git.
RUTA_ARCHIVOS=./archivos
# Cifrado de los archivos (AES-256-GCM). OBLIGATORIA: sin ella el backend no
# arranca. Genere una con:  npm run archivos:generar-llave
# Va SOLO en el .env del servidor (nunca en git). Si se pierde, los documentos
# ya guardados NO se pueden recuperar: guarde una copia aparte, fuera del
# respaldo de la carpeta de archivos (GUIA_DESARROLLO.md, cifrado de archivos).
ARCHIVOS_LLAVE=
# Version de la llave actual. Al rotarla, suba este numero y deje la llave
# anterior en ARCHIVOS_LLAVES_ANTERIORES con el formato "1:llave,2:llave".
ARCHIVOS_LLAVE_VERSION=1
ARCHIVOS_LLAVES_ANTERIORES=

# --- Semilla inicial (solo la primera vez) ---
SEED_ADMIN_CORREO=informatica@munipalmares.go.cr
# Contrasena temporal del super administrador. Si la deja vacia, el seed
# genera una al azar y la imprime una sola vez en la consola.
SEED_ADMIN_CONTRASENA=
